# Copy this file to backend/.env for local overrides.
# Relative paths are resolved from the project root.

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Render provides PORT; it takes precedence over BACKEND_PORT.
# PORT=8000
DATABASE_URL=database/maogongshan.db
UPLOAD_DIR=backend/static/images
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_HOST=
CORS_ORIGIN_REGEX=
ENVIRONMENT=development
SERVICE_NAME=maogongshan-api
READ_ONLY_MODE=false

# Local demonstration account. Change these values before public deployment.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_TOKEN=change-this-admin-token

# Optional model provider. Empty values enable local retrieval QA.
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_CONTEXT_CHARS=12000
LLM_MAX_TOKENS=1200
WEB_SEARCH_PROVIDER=auto-html
WEB_SEARCH_TIMEOUT_SECONDS=10

# Render production reference（render.yaml 已配置，无需手工回填前端域名）：
# DATABASE_URL=/tmp/maogongshan.db
# CORS_ORIGINS=https://maogongshan-red-culture-web-yumingye.onrender.com
# FRONTEND_HOST=maogongshan-red-culture-web-yumingye.onrender.com
# READ_ONLY_MODE=true
# ENVIRONMENT=production
