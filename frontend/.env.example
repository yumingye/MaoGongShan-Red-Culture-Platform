# Copy this file to frontend/.env only when overrides are required.

# Empty in development: Vite proxies /api and /static to the backend.
VITE_API_BASE_URL=

# Optional compatibility variable. Prefer VITE_API_BASE_URL for deployment.
# When VITE_API_BASE_URL is set, it takes precedence.
VITE_API_HOST=
VITE_PUBLIC_READ_ONLY=false

# Local development only.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=5173

# Optional AMap Web JS API. The map page has a local fallback when unset.
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=

# Render production reference:
# VITE_API_BASE_URL=https://maogongshan-red-culture-api-yumingye.onrender.com
# VITE_PUBLIC_READ_ONLY=true
