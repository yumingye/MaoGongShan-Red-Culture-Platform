# Configuration index only. Neither service loads this root file directly.
# Copy backend/.env.example to backend/.env and frontend/.env.example to
# frontend/.env when local overrides are required. Never commit real secrets.

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Render supplies PORT automatically.
PORT=8000
DATABASE_URL=database/maogongshan.db
UPLOAD_DIR=backend/static/images
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_HOST=
CORS_ORIGIN_REGEX=
ENVIRONMENT=development
READ_ONLY_MODE=false
SERVICE_NAME=maogongshan-api
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_TOKEN=change-this-admin-token

VITE_API_BASE_URL=
VITE_API_HOST=
VITE_PUBLIC_READ_ONLY=false
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=5173
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=

# Render production values are defined in render.yaml. Keep localhost values
# above for local development only; production uses the two HTTPS services.

LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_CONTEXT_CHARS=12000
LLM_MAX_TOKENS=1200
WEB_SEARCH_PROVIDER=auto-html
WEB_SEARCH_TIMEOUT_SECONDS=10
